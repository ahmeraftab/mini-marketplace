# Copy to .env.local and fill in. NEVER commit .env.local.

# --- Supabase (Project settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key. Safe in the browser because RLS is on for every table.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret (service-role) key. SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Session-pooler connection string, used on your own machine for migrations
# and type generation only. Do NOT set this on Vercel.
# Percent-encode special characters in the password.
SUPABASE_DB_URL=

# --- AI feature (Google AI Studio key, free tier). Optional: without it the
# "Describe with AI" button is disabled. ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
