    "verify:rls": "tsx --env-file=.env.local --experimental-websocket scripts/verify-rls.ts",
    "images:build": "tsx scripts/build-seed-images.ts",
    "photos:build": "tsx scripts/build-seed-photos.ts",
    "icons:build": "tsx scripts/generate-icons.ts",
    "test:db": "node --import tsx --test tests/db/database.test.ts"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "@hookform/resolvers": "^7.0.6",
